# ==============================================================================
# NovaPulse AI Studio - Environment Variables Example (.env.example)
# انسخ هذا الملف إلى .env واملأ القيم المطلوبة لتشغيل المنصة على استضافتك الخارجية
# ==============================================================================

# منفذ تشغيل الخادم (الافتراضي 3000)
PORT=3000

# بيئة التشغيل: 'development' أو 'production'
NODE_ENV=production

# الرابط الأساسي للنظام على الاستضافة الخارجية (مهم لروابط Meta OAuth والواجهة)
# مثال: https://novapulse.yourdomain.com أو http://localhost:3000
APP_URL="https://your-domain.com"

# ------------------------------------------------------------------------------
# 1. محرك الذكاء الاصطناعي (OpenRouter AI)
# ------------------------------------------------------------------------------
# مفتاح OpenRouter الخاص بالمنصة (يمكن للمستخدمين أيضاً إدخال مفاتيحهم الخاصة من لوحة التحكم)
NOVA_AI_API_KEY="sk-or-v1-your-openrouter-api-key-here"

# الرابط المعتمد لـ OpenRouter API
NOVA_AI_BASE_URL="https://openrouter.ai/api/v1"

# النموذج الافتراضي المجاني (openrouter/free)
NOVA_AI_MODEL="openrouter/free"

# ------------------------------------------------------------------------------
# 2. تكامل فيسبوك الرسمي (Meta Graph API)
# ------------------------------------------------------------------------------
# معرف تطبيق Meta App المنشأ من developers.facebook.com
META_APP_ID="your_meta_app_id"

# السر الخاص بتطبيق Meta App (يُحفظ بأمان في الخادم فقط)
META_APP_SECRET="your_meta_app_secret"

# ------------------------------------------------------------------------------
# 3. محرك الذكاء الاحتياطي (Gemini AI Fallback - اختياري)
# ------------------------------------------------------------------------------
# مفتاح Google Gemini في حال رغبت بتفعيل مسار النسخ الاحتياطي السريع
GEMINI_API_KEY=""
